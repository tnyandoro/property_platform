#!/bin/bash

set -euxo pipefail

echo "=== ESTATE360: Docker entrypoint started ==="
echo "=== ESTATE360: Arguments: $* ==="
echo "=== ESTATE360: RAILS_ENV=${RAILS_ENV:-not set} ==="
echo "=== ESTATE360: PORT=${PORT:-not set} ==="

if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  echo "=== ESTATE360: Running database preparation ==="
  ./bin/rails db:prepare
  echo "=== ESTATE360: Database preparation completed ==="
fi

echo "=== ESTATE360: Starting Rails ==="
exec "$@"
